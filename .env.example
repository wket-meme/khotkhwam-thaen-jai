# Supabase (optional — without these, app falls back to localStorage)
# Get from Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Admin PIN (optional) — unlocks delete controls in the UI.
# Client-side only (compared in the browser / baked into the Vite bundle).
# NOT strong security — anyone who knows or extracts the PIN can unlock the UI.
# localStorage delete works with PIN; Supabase shared delete still needs
# Dashboard / future Edge Function (RLS has no public DELETE).
VITE_ADMIN_PIN=
