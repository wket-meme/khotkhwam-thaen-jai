# Supabase (optional — without these, app falls back to localStorage)
# Get from Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Admin PIN (optional) — unlocks delete controls in the UI (soft UX gate).
# Client-side only (compared in the browser / baked into the Vite bundle).
# NOT strong security — anyone who knows or extracts the PIN can unlock the UI.
# Keep the same value as the server secret ADMIN_PIN (set via supabase secrets).
# localStorage delete works with this PIN unlock alone.
# Shared gallery delete is authorized by Edge Function admin-delete-note.
VITE_ADMIN_PIN=

# --- Server-side only (NOT Vite / NOT .env.local for the frontend) ---
# Set on the Supabase project for Edge Functions (never commit real values):
#
#   npx supabase secrets set ADMIN_PIN=your-pin-here --project-ref ahisxvdbfjhhllysystl
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by
# Supabase into Edge Functions — do not put the service role key in Vite.
#
# Deploy the delete function:
#   npx supabase functions deploy admin-delete-note --project-ref ahisxvdbfjhhllysystl
#
# Invoke URL (client uses supabase.functions.invoke):
#   https://ahisxvdbfjhhllysystl.supabase.co/functions/v1/admin-delete-note
